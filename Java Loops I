import java.util.* ;
public class Solution {
    public static void main(String[] args){
        //print the table 2*1= 2 ... 
        Scanner sc = new Scanner (System.in);
        
        
        int n= sc.nextInt();
        
        for(int i =1 ; i<=10 ; i++){
            
            int result = n * i ; 
            System.out.println( n + " x " + i + " = " + result );
        }
    }
}
